# Mira - Git Ignore

# Sensitive Data (Strictly Local)
data/
*.jsonl
*.faiss
*.index
*.pkl
mira_v3_index/
uploads/

# Environment Variables & Secrets
.env
.env.local
secrets.toml
.streamlit/secrets.toml

