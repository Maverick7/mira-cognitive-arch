*.pyc
*.pyo
build/
dist/
*.egg-info/
.eggs/

# Logs & Debugging
*.log
wandb/
.pytest_cache/
verification_output.txt

# IDE Settings
.vscode/
.idea/
*.swp

# OS Files
.DS_Store
Thumbs.db
